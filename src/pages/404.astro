---
import BaseLayout from '../layouts/BaseLayout.astro';

const base = import.meta.env.BASE_URL;
---

<BaseLayout title="404 — Isabel Ventura" description="La página que buscas no existe o se ha mudado.">
  <main class="error-page">
    <div class="error-content">
      <span class="section-kicker">Error 404</span>
      <p class="error-code">404</p>
      <h1>Esta página se mudó de portfolio</h1>
      <p>Parece que el enlace ya no está disponible. Vuelve al inicio para conocer el blog y el portfolio de Isabel.</p>
      <a class="btn btn-primary" href={base}>Volver al inicio <span aria-hidden="true">→</span></a>
    </div>
  </main>
</BaseLayout>
