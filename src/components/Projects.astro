---
const base = import.meta.env.BASE_URL;

const projects = [
  {
    title: 'Aurora Dashboard',
    image: `${base}images/project-dashboard.svg`,
    alt: 'Vista previa de un panel de métricas con gráficos verdes',
    tags: ['React', 'JavaScript', 'APIs'],
    description: 'Panel de KPIs con filtros y gráficas ligeras, inspirado en mi trabajo con reportes y análisis de métricas de usuario.'
  },
  {
    title: 'FlowDesk',
    image: `${base}images/project-flow.svg`,
    alt: 'Vista previa de un flujo de soporte automatizado',
    tags: ['Node.js', 'SQL', 'Salesforce'],
    description: 'Flujo de incidencias que prioriza tareas y automatiza el seguimiento, nacido de años trabajando en help desk y CRM.'
  },
  {
    title: 'DevNotes',
    image: `${base}images/project-notes.svg`,
    alt: 'Vista previa de una aplicación de notas offline',
    tags: ['JavaScript', 'LocalStorage', 'PWA'],
    description: 'Notas offline que se guardan en el navegador. Rápida, sin fricciones y siempre disponible.'
  }
];
---

<section class="section projects" id="proyectos" aria-labelledby="projects-title">
  <div class="container">
    <div class="section-heading reveal">
      <span class="section-kicker">03 / Proyectos</span>
      <h2 id="projects-title">Portfolio que <span>habla por sí solo</span></h2>
      <p>Tres demostraciones de cómo combino diseño, datos y automatización para crear productos útiles.</p>
    </div>

    <div class="project-grid">
      {projects.map((project) => (
        <article class="project-card reveal">
          <div class="project-image">
            <img src={project.image} alt={project.alt} loading="lazy" decoding="async" />
          </div>
          <div class="project-body">
            <ul class="tag-list">
              {project.tags.map((tag) => <li>{tag}</li>)}
            </ul>
            <h3>{project.title}</h3>
            <p>{project.description}</p>
            <a href={`mailto:isabelrventuraa@yahoo.com?subject=${encodeURIComponent(`Consulta sobre ${project.title}`)}`}>
              Hablar sobre este proyecto <span aria-hidden="true">↗</span>
            </a>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
